{
  "name": "n8n-nodes-ballast",
  "version": "1.0.0",
  "description": "n8n community node for Ballast: cold email sequences, lead management, and Unibox reply triggers.",
  "keywords": [
    "n8n-community-node-package",
    "cold-email",
    "ballast",
    "outreach",
    "email-deliverability",
    "sales-automation"
  ],
  "license": "MIT",
  "homepage": "https://ballast.to",
  "author": {
    "name": "Ballast",
    "email": "contact@ballast.to",
    "url": "https://ballast.to"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/useballast/n8n-nodes-ballast.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BallastApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ballast/Ballast.node.js",
      "dist/nodes/BallastTrigger/BallastTrigger.node.js"
    ],
    "strict": true
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.57.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  }
}
